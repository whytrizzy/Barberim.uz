# Copy to .env.local and fill in. Never commit real values.
# Validated by src/env/schema.ts — the app refuses to start with invalid values.

# development | staging | production
APP_ENV=development

# Neon Postgres (dev branch locally). Pooled URL (host contains -pooler) for the app,
# direct URL (no -pooler) for migrations. Use sslmode=verify-full (Neon has valid certificates).
DATABASE_URL=
DIRECT_URL=

# Bot token from @BotFather. Locally: the DEV bot, never the production bot. (needed from step P0.6)
TELEGRAM_BOT_TOKEN=

# Random 32+ chars (A-Z a-z 0-9 _ -). Required on staging/production; Telegram echoes it to /api/bot.
TELEGRAM_WEBHOOK_SECRET=

# Random 32+ chars. Required on staging/production: the scheduler sends it to /api/cron/dispatch.
# Locally `npm run dev:telegram` runs the outbox itself, so this can stay empty.
CRON_SECRET=

# Cloudflare R2 photo storage. Required on staging/production; leave empty locally (.media/ is used).
MEDIA_BUCKET=
# Public URL of the bucket, no trailing slash, e.g. https://media.barberim.uz
MEDIA_BASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: Yandex Static Maps key (developer.tech.yandex.ru) for map previews
NEXT_PUBLIC_YANDEX_MAPS_KEY=
# Bot username without @, e.g. barberim_dev_bot
NEXT_PUBLIC_BOT_USERNAME=

# Subscription billing (P2.11). Leave BILLING_ENFORCED empty/false: every shop stays PRO.
# true: PRO only while paid up. Price per month in UZS (default 99000).
BILLING_ENFORCED=
PRO_PRICE_UZS=
# Payme Business cabinet: merchant (cashbox) id and key. PAYME_TEST=true uses the test checkout.
# Payme calls POST {NEXT_PUBLIC_APP_URL}/api/billing/payme with account field "order_id".
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=
# Click Merchant: Click calls {NEXT_PUBLIC_APP_URL}/api/billing/click/prepare and .../complete.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# Client deposits (P3.1): encrypts each shop's own Payme/Click/Uzum keys in the database.
# Random 32+ chars, e.g. `openssl rand -base64 48`. Without it, shops can't connect a provider.
DEPOSIT_KEYS_SECRET=
