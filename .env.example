# Copy to .env.local and fill in. Never commit real values.
# Validated by src/env/schema.ts — the app refuses to start with invalid values.

# development | staging | production
APP_ENV=development

# Neon Postgres connection string (needed from step P1.1)
DATABASE_URL=

# Bot token from @BotFather. Locally: the DEV bot, never the production bot. (needed from step P0.6)
TELEGRAM_BOT_TOKEN=

# Random 32+ chars (A-Z a-z 0-9 _ -). Required on staging/production; Telegram echoes it to /api/bot.
TELEGRAM_WEBHOOK_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
# Bot username without @, e.g. barberim_dev_bot
NEXT_PUBLIC_BOT_USERNAME=
