datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CLIENT
  BARBER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id         String   @id @default(uuid())
  telegramId BigInt   @unique @map("telegram_id")
  username   String?  @map("username")
  role       Role     @default(CLIENT)
  phone      String?
  fullName   String   @map("full_name")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  barberProfile BarberProfile?
  clientBookings Booking[]     @relation("ClientBookings")

  @@map("users")
}

/// A barbershop. Owned by one BARBER user, staffed by one or more Masters.
model BarberProfile {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  shopName     String?  @map("shop_name")
  bio          String?
  address      String?
  photoUrl     String?  @map("photo_url")
  workingHours Json     @map("working_hours")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  services Service[]
  masters  Master[]
  bookings Booking[] @relation("BarberBookings")

  @@map("barber_profiles")
}

/// An individual barber working at a shop. Availability is always computed
/// per master (each master has their own calendar), never per shop.
model Master {
  id           String   @id @default(uuid())
  shopId       String   @map("shop_id")
  name         String
  photoUrl     String?  @map("photo_url")
  specialty    String?
  /// null = inherit the shop's working hours
  workingHours Json?    @map("working_hours")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  shop     BarberProfile @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([shopId])
  @@map("masters")
}

model Service {
  id              String   @id @default(uuid())
  barberId        String   @map("barber_id")
  name            String
  durationMinutes Int      @map("duration_minutes")
  price           Int      // Price in UZS
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  barber          BarberProfile    @relation(fields: [barberId], references: [id], onDelete: Cascade)
  bookingServices BookingService[]

  @@map("services")
}

model Booking {
  id        String        @id @default(uuid())
  clientId  String        @map("client_id")
  barberId  String        @map("barber_id")
  /// Nullable only so existing rows can be backfilled; treat as required in code.
  masterId  String?       @map("master_id")
  startTime DateTime      @map("start_time")
  endTime   DateTime      @map("end_time")
  totalPrice Int          @map("total_price")
  status    BookingStatus @default(CONFIRMED)
  notes     String?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  client   User             @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  barber   BarberProfile    @relation("BarberBookings", fields: [barberId], references: [id], onDelete: Cascade)
  master   Master?          @relation(fields: [masterId], references: [id], onDelete: SetNull)
  services BookingService[]

  @@index([masterId, startTime])
  @@map("bookings")
}

model BookingService {
  bookingId String @map("booking_id")
  serviceId String @map("service_id")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([bookingId, serviceId])
  @@map("booking_services")
}
